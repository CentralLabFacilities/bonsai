<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="skills.slots.SlotIO#writeA">
    <datamodel>
        <data id="#_STATE_PREFIX" expr="'de.unibi.citec.clf.bonsai.'"/>
        <data id="#_CONFIGURE_AND_VALIDATE" expr="true"/>
        <data id="#_SLOTS">
            <slots>
                <slot key="ReadSlot" state="test.skills.CompareSlot#readA" xpath="/test/one"/>
                <slot key="ReadSlot" state="test.skills.CompareSlot#readB" xpath="/test/two"/>
                <slot key="StringSlot" state="skills.slots.SlotIO#writeB" xpath="/test/two"/>
                <slot key="StringSlot" state="skills.slots.SlotIO#writeA" xpath="/test/one"/>
            </slots>
        </data>

    </datamodel>

    <state id="skills.slots.SlotIO#writeA">
        <datamodel>
            <data id="#_WRITE" expr="'A'"/>
        </datamodel>
        <transition event="SlotIO.success" target="skills.slots.SlotIO#writeB"/>
        <transition event="SlotIO.error" target="skills.Fatal"/>
        <transition event="SlotIO.fatal" target="skills.Fatal"/>
    </state>

    <state id="skills.slots.SlotIO#writeB">
        <datamodel>
            <data id="#_WRITE" expr="'B'"/>
        </datamodel>
        <transition event="SlotIO.success" target="test.skills.CompareSlot#readA"/>
        <transition event="SlotIO.error" target="skills.Fatal"/>
        <transition event="SlotIO.fatal" target="skills.Fatal"/>
    </state>

    <state id="test.skills.CompareSlot#readA">
        <datamodel>
            <data id="#_COMPARE_STRING" expr="'A'"/>
        </datamodel>
        <transition event="CompareSlot.success.match" target="test.skills.CompareSlot#readB"/>
        <transition event="CompareSlot.success.misMatch" target="skills.Fatal"/>
        <transition event="CompareSlot.error" target="skills.Fatal"/>
        <transition event="CompareSlot.fatal" target="skills.Fatal"/>
    </state>

    <state id="test.skills.CompareSlot#readB">
        <datamodel>
            <data id="#_COMPARE_STRING" expr="'B'"/>
        </datamodel>
        <transition event="CompareSlot.success.match" target="skills.End"/>
        <transition event="CompareSlot.success.misMatch" target="skills.Fatal"/>
        <transition event="CompareSlot.error" target="skills.Fatal"/>
        <transition event="CompareSlot.fatal" target="skills.Fatal"/>
    </state>


    <state id="skills.Fatal" final="true"/>

    <state id="skills.End" final="true"/>
</scxml>