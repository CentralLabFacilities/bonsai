<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" initial="skills.slots.SlotIO">
    <datamodel>
        <data id="#_SLOTS">
            <slots>
                <inheritSlot key="StringSlot" state="skills.slots.SlotIO" xpath="/B"/>
                <inheritSlot key="StringSlot" state="skills.slots.SlotIO#1" xpath="/C"/>
                <slot key="StringSlot" state="skills.slots.SlotIO#2" xpath="/D"/>

            </slots>
        </data>
        <data id="test_val" expr="2"/>
        <data id="no_change_test_val" expr="2"/>
    </datamodel>

    <state id="skills.slots.SlotIO">
        <transition event="SlotIO.*" target="skills.slots.SlotIO#1"/>
    </state>

    <state id="skills.slots.SlotIO#1">
        <transition event="SlotIO.*" target="skills.slots.SlotIO#2"/>
    </state>

    <state id="skills.slots.SlotIO#2">
        <datamodel>
            <data id="#_WRITE" expr="@test_val"/>
        </datamodel>
        <transition event="SlotIO.*" target="skills.Nop"/>
    </state>

    <state id="skills.Nop">
        <transition event="Nop.*">
            <send event="success"/>
        </transition>
    </state>
</scxml>
