{
  "name": "bonsai-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun node_modules/vite/bin/vite.js",
    "tauri:dev": "tauri dev",
    "build": "bun node_modules/vite/bin/vite.js build",
    "tauri:build": "bun run build && tauri build",
    "build:binary": "mkdir -p target/dist && bun run build --outDir target/dist && bun run src/embed-assets.js target/dist target/embedded-assets.js && bun build src/server.js --compile --target=bun-linux-x64 --outfile target/bonsai-ui && rm -rf target/dist",
    "lint": "bun node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "test": "bun scripts/verify.mjs unit",
    "test:rust": "bun scripts/verify.mjs rust",
    "test:browser": "bun scripts/verify.mjs browser",
    "test:browser:update": "bun scripts/verify.mjs browser --update-snapshots",
    "verify": "bun scripts/verify.mjs",
    "preview": "bun node_modules/vite/bin/vite.js preview"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tisoap/react-flow-smart-edge": "^5.0.0",
    "@xyflow/react": "^12.11.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "happy-dom": "^20.14.5",
    "vite": "^8.1.1"
  }
}
